{
  "name": "suivi-candidature",
  "version": "1.0.0",
  "private": true,
  "description": "Outil personnel de suivi de candidatures, alimenté par les mails reçus sur Gmail.",
  "type": "module",
  "scripts": {
    "list": "tsx src/list-recent.ts",
    "sync": "tsx src/sync-run.ts",
    "extract": "tsx src/extract-run.ts",
    "filter": "tsx src/filter-run.ts",
    "eval:classify": "tsx src/classify-eval.ts",
    "reanalyse": "tsx src/reanalyse.ts",
    "candidatures": "tsx src/candidatures-run.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ui": "tsx src/ui/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SulyvanDal/suivi-candidature.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@googleapis/gmail": "^22.0.1",
    "@hono/node-server": "^2.1.3",
    "google-auth-library": "^11.1.0",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "htmx.org": "^2.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
